{
  "$schema": "https://opencode.ai/config.json",
  "model": {
    "default": "deepseek-v4-flash-free",
    "temperature": 0.3,
    "maxTokens": 8192
  },
  "default_agent": "build",
  "lsp": {
    "java": {
      "command": [
        "java",
        "-jar",
        "C:/Users/Lenovo/AppData/Local/opencode/lsp/java-language-server.jar"
      ],
      "extensions": ["java"]
    }
  },
  "permission": {
    "bash": "allow",
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "write": "ask",
    "task": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "question": "allow",
    "lsp": "allow",
    "skill": "allow"
  },
  "agents": {
    "explore": {
      "description": "Contextual grep for codebase discovery",
      "prompt": "You are an expert at finding code in the taotao-cloud-auth project. Search thoroughly and return exact file paths with pattern descriptions."
    },
    "librarian": {
      "description": "External reference and documentation search",
      "prompt": "You are a research specialist for the taotao-cloud-auth project. Find external documentation, OSS examples, and best practices for Spring Security OAuth2, JDK 25, Gradle 9.5, and related technologies."
    }
  }
}
