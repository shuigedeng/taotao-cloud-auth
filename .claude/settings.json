{
  "version": "2.0",
  "permissions": {
    "read": [
      "taotao-cloud-auth-api/src/**/*.java",
      "taotao-cloud-auth-biz/src/**/*.java",
      "taotao-cloud-auth-biz/src/**/*.yml",
      "taotao-cloud-auth-biz/src/**/*.yaml",
      "taotao-cloud-auth-biz/src/**/*.properties",
      "build.gradle",
      "settings.gradle",
      "gradle/**/*.gradle",
      "gradle/libs.versions.toml",
      "taotao-cloud-auth-api/build.gradle",
      "taotao-cloud-auth-biz/build.gradle"
    ],
    "write": [
      "taotao-cloud-auth-api/src/**/*.java",
      "taotao-cloud-auth-api/src/main/proto/**/*.proto",
      "taotao-cloud-auth-biz/src/**/*.java",
      "taotao-cloud-auth-biz/src/**/*.yml",
      "taotao-cloud-auth-biz/src/**/*.yaml",
      "taotao-cloud-auth-biz/src/**/*.properties",
      "taotao-cloud-auth-biz/Dockerfile"
    ],
    "execute": [
      "gradlew",
      "git",
      "docker"
    ],
    "network": [
      "localhost:8080",
      "localhost:3306",
      "localhost:8848",
      "api.github.com"
    ]
  },
  "model": {
    "default": "deepseek-v4-flash-free",
    "temperature": 0.3,
    "maxTokens": 8192
  },
  "git": {
    "autoCommit": false,
    "requireTests": true,
    "commitMessageTemplate": "type(scope): description"
  },
  "java": {
    "buildTool": "gradle",
    "version": "25",
    "enablePreview": true,
    "compileCommand": "gradlew :taotao-cloud-auth-biz:compileJava",
    "testCommand": "gradlew test",
    "buildCommand": "gradlew build",
    "bootRunCommand": "gradlew :taotao-cloud-auth-biz:bootRun --args='--spring.profiles.active=dev'",
    "packagingCommand": "gradlew :taotao-cloud-auth-biz:bootJar"
  },
  "integrations": {
    "sonarqube": {
      "enabled": true,
      "url": "http://localhost:9000"
    }
  },
  "project": {
    "type": "spring-boot",
    "framework": "spring-authorization-server",
    "profiles": ["dev", "test", "pre", "pro"],
    "modules": ["taotao-cloud-auth-api", "taotao-cloud-auth-biz"],
    "package": "com.taotao.cloud.auth",
    "bom": "io.github.shuigedeng:taotao-cloud-dependencies:2026.07"
  }
}
